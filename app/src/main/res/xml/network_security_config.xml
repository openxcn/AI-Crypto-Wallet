<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止所有明文 HTTP 流量，防止自定义 RPC 节点被中间人攻击篡改响应 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
