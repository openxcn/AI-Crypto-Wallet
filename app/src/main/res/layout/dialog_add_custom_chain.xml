<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_chain_code"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/etChainCode"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. BSC-Testnet"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E6E7A"
            android:background="@drawable/input_background"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_chain_display_name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/etChainName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. BNB Smart Chain Testnet"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E6E7A"
            android:background="@drawable/input_background"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_rpc_node"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/etChainRpc"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="https://..."
            android:textColor="#FFFFFF"
            android:textColorHint="#6E6E7A"
            android:background="@drawable/input_background"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_native_symbol"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/etChainSymbol"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="e.g. tBNB"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E6E7A"
            android:background="@drawable/input_background"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_decimals"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
        <EditText
            android:id="@+id/etChainDecimals"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="18"
            android:textColor="#FFFFFF"
            android:textColorHint="#6E6E7A"
            android:background="@drawable/input_background"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <CheckBox
            android:id="@+id/cbIsEVM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_is_evm_chain"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>