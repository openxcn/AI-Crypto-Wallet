<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1a1a2e"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/card_background" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/str_transfer_2"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Token Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/balance_card_background"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTokenSymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETH"
                        android:textColor="#ffffff"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tvTokenSwitchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ▼"
                        android:textColor="#667eea"
                        android:textSize="14sp"
                        android:layout_marginStart="2dp" />

                    <TextView
                        android:id="@+id/tvAvailable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/str_available"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTokenValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="#4ade80"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Recipient Address -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_collections_2"
                android:textColor="#8892b0"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etToAddress"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="@string/str_enter_your_payout_address"
                    android:textColor="#ffffff"
                    android:textColorHint="#4a4a6a"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/btnPaste"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/str_paste"
                    android:textColor="#667eea"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/card_background"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnAddressBook"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="📇"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/card_background"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnScan"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="📷"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/card_background" />
            </LinearLayout>

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_transfer_2"
                android:textColor="#8892b0"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_background"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="0.00"
                    android:textColor="#ffffff"
                    android:textColorHint="#4a4a6a"
                    android:textSize="20sp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:id="@+id/tvMaxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="MAX"
                    android:textColor="#667eea"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/card_background"
                    android:layout_marginEnd="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUsdValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="≈ $0.00"
                android:textColor="#4a4a6a"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- Gas Fee -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_gas_cost"
                        android:textColor="#ffffff"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGasFee"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/text_memuat"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGasSlow"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/str_slower"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:background="@drawable/card_background"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btnGasNormal"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/str_standard"
                        android:textColor="#667eea"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/card_background"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/btnGasFast"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/str_faster"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:background="@drawable/card_background" />
                </LinearLayout>
            </LinearLayout>

            <!-- Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0d0d1e"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_grand_total"
                        android:textColor="#8892b0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 ETH"
                        android:textColor="#ffffff"
                        android:textSize="13sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_net"
                        android:textColor="#8892b0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvNetwork"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ethereum"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Send Button -->
            <TextView
                android:id="@+id/btnSendConfirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/title_proceed_to_transfer"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/balance_card_background" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>