<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1a1a2e"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="←"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/card_background" />

        <TextView
            android:id="@+id/btnForward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="→"
            android:textColor="#4a4a6a"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="↻"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/btnConnectWallet"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/str_with_wallet"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/card_background"
            android:layout_marginStart="4dp" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="@string/str_enter_dapp_address"
            android:textColor="#ffffff"
            android:textColorHint="#4a4a6a"
            android:textSize="12sp"
            android:singleLine="true"
            android:background="@drawable/card_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="GO"
            android:textColor="#667eea"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/card_background"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="⋮"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/card_background"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="#667eea"
        android:visibility="gone" />

    <!-- 白名单滚动提示（仅当前 DApp 在白名单时显示） -->
    <TextView
        android:id="@+id/tvWhitelistMarquee"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="#331818"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollHorizontally="true"
        android:textColor="#f59e0b"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone" />

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- DApp Bookmarks (shown when on home page) -->
    <com.aicryptowallet.app.NoScrollInterceptScrollView
            android:id="@+id/bookmarksContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 发现 / 我的 切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_background"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvTabHot"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/str_popular"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/trade_tab_active" />

                <TextView
                    android:id="@+id/tvTabCross"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/str_cross_chain"
                    android:textColor="#6E6E7A"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTitleHot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_popular"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/dappGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 跨链：跨链桥 DApp -->
            <TextView
                android:id="@+id/tvTitleCross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_cross_chain"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/crossChainGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </com.aicryptowallet.app.NoScrollInterceptScrollView>
</LinearLayout>