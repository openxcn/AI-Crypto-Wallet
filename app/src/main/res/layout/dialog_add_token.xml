<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_add_tokens_manually"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_contract_0x"
        android:textColor="#8892b0"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etContractAddress"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="0x..."
        android:textColor="#ffffff"
        android:textColorHint="#4a4a6a"
        android:textSize="13sp"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:singleLine="true"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_name_optional"
        android:textColor="#8892b0"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTokenSymbol"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="USDT"
        android:textColor="#ffffff"
        android:textColorHint="#4a4a6a"
        android:textSize="13sp"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_name_optional"
        android:textColor="#8892b0"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTokenName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Tether USD"
        android:textColor="#ffffff"
        android:textColorHint="#4a4a6a"
        android:textSize="13sp"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:singleLine="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_decimals_optional_default_18"
        android:textColor="#8892b0"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etTokenDecimals"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="18"
        android:textColor="#ffffff"
        android:textColorHint="#4a4a6a"
        android:textSize="13sp"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:singleLine="true"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/str_tip_when_you_leave"
        android:textColor="#4a4a6a"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />
</LinearLayout>