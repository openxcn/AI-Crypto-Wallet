<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_add_tokens_pound"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- 搜索框 -->
    <EditText
        android:id="@+id/etTokenSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="@string/str_search_token_hint"
        android:textColor="#ffffff"
        android:textColorHint="#4a4a6a"
        android:textSize="13sp"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:singleLine="true"
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawableTint="#4a4a6a"
        android:layout_marginBottom="12dp" />

    <!-- 三个选项 Tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#232342"
        android:padding="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tabHomeAssets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="#8892b0"
            android:textSize="13sp"
            android:text="首页资产" />

        <TextView
            android:id="@+id/tabCustomTokens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="#8892b0"
            android:textSize="13sp"
            android:text="自定义代币" />

        <TextView
            android:id="@+id/tabPopularTokens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="#8892b0"
            android:textSize="13sp"
            android:text="热门代币" />
    </LinearLayout>

    <!-- 内容区 -->
    <ScrollView
        android:id="@+id/scrollTokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="220dp"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/tokenManageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/btnRestoreHidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/btn_restore_hidden_tokens"
        android:textColor="#ff6b6b"
        android:textSize="13sp"
        android:background="@drawable/input_background" />
</LinearLayout>