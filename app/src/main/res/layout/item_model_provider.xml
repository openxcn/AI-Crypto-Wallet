<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvProviderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OpenAI"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProviderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_not_configured"
                    android:textColor="#6E6E7A"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="#1a1a2e" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeyInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Key: sk-****abcd"
                android:textColor="#667eea"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnGetKey"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/str_get_key"
            android:textColor="#4ade80"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/card_background"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnConfigKey"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="@string/str_configure"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/card_background" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnActivate"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:text="@string/text_aktivasi"
        android:textColor="#4ADE80"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/gradient_button_bg"
        android:visibility="gone" />
</LinearLayout>