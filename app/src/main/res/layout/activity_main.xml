<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐"
            android:textSize="48sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Crypto Wallet"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_secure_smart_multi_chain"
            android:textColor="#8892b0"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_select_main_chain"
            android:textColor="#8892b0"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/chainGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:columnCount="4"
            app:rowCount="5"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/str_create_new_wallet"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_background"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/str_import_an_existing_wallet"
            android:textColor="#8892b0"
            android:textSize="15sp"
            android:background="@drawable/card_background" />

    </LinearLayout>
</ScrollView>