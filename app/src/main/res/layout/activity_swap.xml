<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a1a"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1a1a2e"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="←"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/card_background" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_exchange"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text=""
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/card_background" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- From Token -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/balance_card_background"
                android:padding="20dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_from"
                        android:textColor="#8892b0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvFromBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/str_balance"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etFromAmount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="0.0"
                        android:textColor="#ffffff"
                        android:textColorHint="#4a4a6a"
                        android:textSize="28sp"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:id="@+id/tvFromToken"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="ETH"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/card_background" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFromUsd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≈ $0.00"
                    android:textColor="#4a4a6a"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Swap Button -->
            <TextView
                android:id="@+id/btnSwitchTokens"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="⇅"
                android:textColor="#667eea"
                android:textSize="24sp"
                android:gravity="center"
                android:background="@drawable/card_background"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <!-- To Token -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/balance_card_background"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_to"
                        android:textColor="#8892b0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvToBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/str_balance"
                        android:textColor="#8892b0"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etToAmount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="0.0"
                        android:textColor="#ffffff"
                        android:textColorHint="#4a4a6a"
                        android:textSize="28sp"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:background="@android:color/transparent"
                        android:focusable="false" />

                    <TextView
                        android:id="@+id/tvToToken"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="USDT"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/card_background" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvToUsd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≈ $0.00"
                    android:textColor="#4a4a6a"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Price Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_exchange_rate"
                        android:textColor="#8892b0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 ETH = 0 USDT"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_a_bit_slippery"
                        android:textColor="#8892b0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSlippage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0.5%"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_minimum_earned"
                        android:textColor="#8892b0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMinReceived"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 USDT"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Swap Button -->
            <TextView
                android:id="@+id/btnSwapConfirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/text_enter_amount"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/balance_card_background" />

        </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>