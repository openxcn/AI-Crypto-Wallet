<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A1F"
    android:padding="24dp"
    android:layout_margin="32dp">

    <TextView
        android:id="@+id/tvRiskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_cross_chain_exchange_risk"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRiskContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnRiskConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/str_i_understand_the_risks"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:backgroundTint="#2997F4"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRiskCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_s_decline"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:backgroundTint="#3A3A42" />

</LinearLayout>